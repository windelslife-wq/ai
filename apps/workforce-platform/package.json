{
  "name": "@windels/workforce-platform",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.20.0 <25"
  },
  "scripts": {
    "start": "node server.js",
    "start:passenger": "node passenger-start.cjs",
    "dev:client": "npm --prefix client run dev",
    "build:client": "npm --prefix client run build",
    "migrate": "node src/db/migrate.js",
    "seed:platform": "node tools/seed-platform.mjs",
    "import:identity": "node src/db/import-legacy-identity.js",
    "backup": "node tools/backup.mjs create",
    "restore": "node tools/backup.mjs restore",
    "prune:analysis": "node tools/prune-analysis-runs.mjs",
    "verify:install": "node tools/verify-install.mjs",
    "verify:data": "node tools/verify-data.mjs",
    "test": "node --test test/*.test.js",
    "check": "npm run verify:install && npm test",
    "migrate:status": "node src/db/migrate.js --status",
    "migrate:dry-run": "node src/db/migrate.js --dry-run",
    "build:icons": "node tools/generate-icons.mjs",
    "check:icons": "node tools/generate-icons.mjs --check"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "mysql2": "^3.24.5"
  }
}
