# WINDELS AI WORKFORCE — Node platform configuration.
#
# Every variable the platform reads is listed here with its default. Values shown
# are safe for a local machine, NOT for a deployment: secrets belong in cPanel's
# environment UI (or a private shell file you source), never in this file.
# The server does not auto-load .env — export them, or `set -a; . ./.env; set +a`.
#
# `npm run verify:install` fails if a variable the config reads is missing here.

# ---- runtime --------------------------------------------------------------
# development | test | production. Anything else is refused at boot.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# Required in production and must be an HTTPS origin: it is the same-origin
# reference for CSRF/origin checks, the cookie scope, and CORS comparisons.
# PUBLIC_BASE_URL=https://workforce.example.com
# Set true only after confirming the cPanel/Passenger proxy hop, otherwise
# X-Forwarded-For is attacker-controlled and per-client limits key on the proxy.
TRUST_PROXY=false
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Stamp the build so /api/v1/system/status reports what is actually deployed.
# WF_BUILD_VERSION=0.3.0+2026-10-09
# Override the application root (data/ uploads resolve against it) and the static
# document root. Only ever point these at public assets.
# WF_APP_ROOT=/home/account/apps/workforce-platform
# WF_PUBLIC_DIR=/home/account/apps/workforce-platform/public
# Public landing-site copy and install metadata (site name, manifest, SEO).
# These drive the rendered public pages, /robots.txt, /sitemap.xml and
# /manifest.webmanifest; legacy parity: application/config/seo.php (VP_*).
# SITE_NAME=WINDELS AI WORKFORCE
# SITE_DESCRIPTION=WINDELS AI WORKFORCE — research, learning and operational tools in one governed workspace. Evidence-first, audited and fail-closed.
# Defaults to " · <SITE_NAME>"; set empty to drop the suffix.
# SITE_TITLE_SUFFIX=
# THEME_COLOR=#071511
# SITE_BACKGROUND_COLOR=#071511
# One of: "index, follow" | "noindex, follow" | "index, nofollow" | "noindex, nofollow".
# ROBOTS=index, follow
# SITE_KEYWORDS=WINDELS AI Workforce, AI workforce, language learning, market intelligence, sports research, lottery analysis, lead discovery
# Absolute https:// URL of the shared social image. Without it the canonical
# origin's /icons/icon-512.png is used, and with no PUBLIC_BASE_URL the Open
# Graph image tag is omitted rather than publishing a relative URL.
# SITE_OG_IMAGE=https://workforce.example.com/icons/icon-512.png
# Operator announcements, "|" separated, max three, shown as the site banner.
# Empty by default: a banner that claims an unported module would be a lie.
# SITE_ANNOUNCEMENT=Welcome to WINDELS AI WORKFORCE.
# Size of the legacy authored language-teacher registry quoted by the public
# pages. Language learning is not ported to Node yet, so this is a stated
# constant describing the product, not a live count. 0 drops the claim.
# SITE_LANGUAGE_COUNT=20
# Public contact intake throttle (per client address) and accepted message
# length; mirrors the legacy form rules (10..2000 characters).
# CONTACT_MAX_PER_HOUR=3
# CONTACT_WINDOW_MS=3600000

# ---- storage adapter ------------------------------------------------------
# auto | mysql | file. `auto` picks mysql when DB_* are present, else file.
# `file` is refused in production unless ALLOW_FILE_STORE_IN_PRODUCTION=1
# acknowledges: single process, no transactions, no cross-process locking.
STORAGE_ADAPTER=auto
# Where the file adapter keeps its write-ahead log, and where avatars go.
# Defaults: .data/store (development) / data/store (production), data/uploads.
# STORAGE_DIR=/home/account/apps/workforce-platform/.data/store
# UPLOAD_DIR=/home/account/apps/workforce-platform/data/uploads
ALLOW_FILE_STORE_IN_PRODUCTION=0
# Connection pool for the MySQL adapter.
DB_CONNECTION_LIMIT=5

# ---- database (MySQL/MariaDB through cPanel) ------------------------------
# Required when STORAGE_ADAPTER=mysql.
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=cpanel_database_name
# DB_USER=cpanel_database_user
# DB_PASSWORD=replace-with-a-secret
# CLI-only, separate credentials for the one-time legacy identity import. These
# are deliberately NOT read by the server, so a web process can never touch the
# legacy database. Used by `npm run import:identity`.
# LEGACY_DB_HOST=localhost
# LEGACY_DB_PORT=3306
# LEGACY_DB_NAME=legacy_database_name
# LEGACY_DB_USER=legacy_readonly_user
# LEGACY_DB_PASSWORD=replace-with-a-secret
# LEGACY_DB_CONNECTION_LIMIT=2

# ---- sessions and cookies --------------------------------------------------
# Generate a fresh value of at least 32 bytes per environment. It also keys the
# CSRF token derivation and the login-attempt hashing, so rotating it invalidates
# every session — which is exactly what you want after an incident.
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
# Web session lifetime, 300s..7d. A remembered sign-in extends the same session
# up to 30 days; a password change returns it to this TTL.
SESSION_TTL_SECONDS=28800
# Force Secure (and therefore the __Host- name) outside production for tests.
# COOKIE_SECURE=0

# ---- request handling ------------------------------------------------------
# JSON/form body cap, 1 KiB..1 MiB. Bodies are buffered, never streamed to disk.
BODY_LIMIT_BYTES=16384
# Socket inactivity cap for the whole request/response cycle.
REQUEST_TIMEOUT_MS=15000
# multipart cap for avatar uploads, 32 KiB..16 MiB (defaults to UPLOAD_MAX_BYTES + 64 KiB).
UPLOAD_BODY_LIMIT_BYTES=2113536
# Concurrent in-flight requests allowed per client address (0 disables). A
# windowed counter limits rate; this stops one address holding hundreds of slow
# connections open. Set it deliberately on shared-host deployments, not by guess.
# MAX_REQUESTS_PER_CLIENT=0

# ---- uploads ---------------------------------------------------------------
UPLOADS_ENABLED=1
# Per-file cap, 1 KiB..10 MiB. Content is sniffed; the declared MIME is ignored.
UPLOAD_MAX_BYTES=2097152
# Private cache lifetime for authorized avatar reads.
UPLOAD_CACHE_SECONDS=300

# ---- rate limiting and lockout (per process; a floor, not a global ceiling) --
RATE_LIMIT_ENABLED=1
RATE_LIMIT_API_MAX=120
RATE_LIMIT_API_WINDOW_MS=60000
# Failed sign-ins per client per route window; also the credential-spray throttle.
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MS=60000
# Cap on tracked buckets so a spread of random keys cannot grow memory.
RATE_LIMIT_MAX_ENTRIES=20000
# Analysis is the most expensive authenticated surface here: one run fetches up to
# 8 upstream series (a forex/commodity run also pulls seven reference legs) and one
# consensus scan is up to 10 runs, so a 10-symbol scan can fan out into ~80
# provider calls. The API limiter above bounds requests; these bound work.
# Window limits are per client address and are charged before validation, so a
# refused request still counts.
RATE_LIMIT_ANALYSIS_RUN_MAX=12
RATE_LIMIT_ANALYSIS_RUN_WINDOW_MS=600000
RATE_LIMIT_ANALYSIS_CONSENSUS_MAX=4
RATE_LIMIT_ANALYSIS_CONSENSUS_WINDOW_MS=600000
# In-flight analysis runs per signed-in session (a scan holds one slot). 0
# disables the cap, matching MAX_REQUESTS_PER_CLIENT semantics.
ANALYSIS_MAX_CONCURRENT_RUNS=2
# Strategy Lab cost control. A backtest fetches up to 5000 candles and simulates
# every bar; an optimization re-runs the backtester once per grid combination and
# once per walk-forward segment (~50 simulations for trend-following), so its
# window is much tighter. Window limits are per client address and are charged
# before validation, so a refused request still counts.
RATE_LIMIT_STRATEGY_BACKTEST_MAX=12
RATE_LIMIT_STRATEGY_BACKTEST_WINDOW_MS=600000
RATE_LIMIT_STRATEGY_OPTIMIZE_MAX=2
RATE_LIMIT_STRATEGY_OPTIMIZE_WINDOW_MS=600000
# In-flight backtests + optimizations per signed-in session. Lower than the
# analysis cap of 2 on purpose: one optimize slot can hold ~50 simulations, so two
# slots would put ~100 on a host that may have two cores. 0 disables the cap.
STRATEGY_MAX_CONCURRENT_RUNS=1
# --- Research-only portfolio optimizer (row 9) ---
# One optimization fetches up to TWELVE candle series sequentially, then solves two
# iterative programs over a 12x12 covariance. The window is tighter than the
# analysis-run window because the requests are cheap to refuse and the upstream
# provider calls are not.
RATE_LIMIT_PORTFOLIO_OPTIMIZE_MAX=6
RATE_LIMIT_PORTFOLIO_OPTIMIZE_WINDOW_MS=600000
# In-flight optimizations per signed-in session, on the same reasoning as
# STRATEGY_MAX_CONCURRENT_RUNS: one heavy job at a time is the honest bound on a
# two-core cPanel host. Keyed by session, not by address, so a shared office NAT
# cannot let one colleague's run starve another's. 0 disables the cap.
PORTFOLIO_MAX_CONCURRENT_RUNS=1
# Days of analysis runs to keep. Each run stores a full LONGTEXT payload (agents,
# debate transcript, scenarios, setup, risk decision, provenance) and nothing else
# ever deletes a row. Applied by an operator, never by a request:
#   node tools/prune-analysis-runs.mjs            # dry run, deletes nothing
#   node tools/prune-analysis-runs.mjs --apply    # actually delete
# 0 keeps runs forever.
ANALYSIS_RETENTION_DAYS=90
# Account lockout: N failures lock that account for the window. Keyed per account,
# never per address, so a shared office IP cannot be used to deny service.
LOGIN_LOCKOUT_FAILURES=5
LOGIN_LOCKOUT_MS=900000

# ---- CORS and Content Security Policy --------------------------------------
# Comma-separated exact origins for browser clients served from another origin.
# Wildcards and plain http (in production) are refused at boot. Same-origin
# deployments need nothing here.
# CORS_ALLOWED_ORIGINS=https://admin.example.com
# Development-only convenience for an inline <script> in a hand-written page.
# Ignored — not honoured — in production.
# CSP_UNSAFE_INLINE=0

# ---- password policy (mirrors the legacy PHP application) -------------------
PASSWORD_MIN_LENGTH=12
ADMIN_PASSWORD_MIN_LENGTH=14

# ---- market data providers (Phase 4) --------------------------------------
# The provider chain is Binance (crypto, priority 10) → Frankfurter/ECB (daily
# forex, 20) → licensed stock/ETF/futures/options adapters (30–33, inert until
# configured) → synthetic demo generator (999, always last).
# Set 0 on a host with no outbound access: the real providers are then not
# registered at all, and every response says it came from the synthetic provider.
MARKET_DATA_REAL_PROVIDERS=1
# Set 0 to refuse synthetic data outright. Requests then fail with 503
# SYNTHETIC_DATA_DISABLED instead of being served simulated candles — the setting
# to use on any host whose output must never be mistaken for market data.
MARKET_DATA_ALLOW_SYNTHETIC=1
# Per-request timeout for one provider call, 500..30000 ms.
MARKET_DATA_TIMEOUT_MS=6000
# Retries per provider call, 0..5 (backoff 300 ms × 2^attempt, capped at 1 s).
MARKET_DATA_RETRIES=2
# Hard budget for a whole market-data request across every provider in the chain,
# 1000..120000 ms. Added by this port: the legacy manager had no overall deadline.
MARKET_DATA_DEADLINE_MS=15000
# Shorter budget for provider health probes, 500..60000 ms.
MARKET_DATA_HEALTH_TIMEOUT_MS=5000
# Public market-data hosts. Override only for a mirror or a corporate proxy;
# production refuses a non-HTTPS value.
# BINANCE_API_BASE=https://api.binance.com
# FRANKFURTER_API_BASE=https://api.frankfurter.dev
# Licensed feeds (stock, ETF, futures, options). Each adapter stays DISABLED until
# _ENABLED=1, and NOT_CONFIGURED until a safe URL, license metadata and an
# explicit symbol allow-list are supplied. No symbol discovery, no invented data.
# Variable names keep the legacy AEGIS_* spelling so a cPanel environment carries
# over unchanged. All four prefixes are listed in full below rather than by
# reference: a variable an operator cannot see is a variable they cannot set, and
# "the same seven exist for the others" is exactly the wording that let three of
# these four adapters ship undocumented (F-33).
# AEGIS_STOCK_DATA_URL=https://licensed-feed.example.com/stocks
# AEGIS_STOCK_DATA_HEALTH_URL=https://licensed-feed.example.com/health
# AEGIS_STOCK_DATA_TOKEN=replace-with-a-bearer-token
# AEGIS_STOCK_DATA_LICENSE=vendor-license-reference
# AEGIS_STOCK_DATA_ENABLED=0
# Delayed unless set to exactly 0; reported in the response provenance.
# AEGIS_STOCK_DATA_DELAYED=1
# Comma or space separated allow-list, upper-cased, 1..64 chars of [A-Z0-9._:-].
# AEGIS_STOCK_DATA_SYMBOLS=AAPL,MSFT
# Licensed ETF data (priority 31) — the same seven variables as AEGIS_STOCK_DATA_.
# AEGIS_ETF_DATA_URL=https://licensed-feed.example.com/etfs
# AEGIS_ETF_DATA_HEALTH_URL=https://licensed-feed.example.com/health
# AEGIS_ETF_DATA_TOKEN=replace-with-a-bearer-token
# AEGIS_ETF_DATA_LICENSE=vendor-license-reference
# AEGIS_ETF_DATA_ENABLED=0
# AEGIS_ETF_DATA_DELAYED=1
# AEGIS_ETF_DATA_SYMBOLS=SPY,QQQ
# Licensed futures data (priority 32) — the same seven variables as AEGIS_STOCK_DATA_.
# AEGIS_FUTURES_DATA_URL=https://licensed-feed.example.com/futures
# AEGIS_FUTURES_DATA_HEALTH_URL=https://licensed-feed.example.com/health
# AEGIS_FUTURES_DATA_TOKEN=replace-with-a-bearer-token
# AEGIS_FUTURES_DATA_LICENSE=vendor-license-reference
# AEGIS_FUTURES_DATA_ENABLED=0
# AEGIS_FUTURES_DATA_DELAYED=1
# AEGIS_FUTURES_DATA_SYMBOLS=ES,FGBL
# Licensed options data (priority 33) — the same seven variables as AEGIS_STOCK_DATA_.
# AEGIS_OPTIONS_DATA_URL=https://licensed-feed.example.com/options
# AEGIS_OPTIONS_DATA_HEALTH_URL=https://licensed-feed.example.com/health
# AEGIS_OPTIONS_DATA_TOKEN=replace-with-a-bearer-token
# AEGIS_OPTIONS_DATA_LICENSE=vendor-license-reference
# AEGIS_OPTIONS_DATA_ENABLED=0
# AEGIS_OPTIONS_DATA_DELAYED=1
# AEGIS_OPTIONS_DATA_SYMBOLS=SPX,NDX

# ---------------------------------------------------------------------------
# Broker Center connectors (module: brokers)
# ---------------------------------------------------------------------------
# Ten adapters are registered on every boot and ALL are disabled by default.
# Registering is not enabling: an unconfigured connector reports DISABLED without
# performing any I/O, cannot be read from, and can never be returned as routable.
#
# Four independent switches, in the order the gates check them:
#   _ENABLED=1            the connector may be probed and read at all
#   _URL / _TOKEN         an absolute http(s) URL with NO credentials, plus a token
#   _TRADING_ENABLED=1    local intent to submit orders
#   _LIVE_ALLOWED=1       additionally required for any account that is not `demo`
#
# Order submission needs the local flag AND a bridge that reports
# `tradingEnabled: true` AND a demo account, unless _LIVE_ALLOWED=1 is also set.
# No provider is ever silently live and the adapter never guesses whether an
# account is safe to trade. Every write re-runs all of these gates against a
# freshly probed health response — a cached READY is not a reason to place an order.
#
# Variable names keep the legacy AEGIS_* spelling so a cPanel environment carries
# over unchanged. Production requires https://, except for a loopback bridge
# (127.0.0.1, [::1], localhost), which may stay on http:// because the MT5 bridge
# is a local service and a self-signed certificate is a worse answer than the
# plain socket.
#
# MetaTrader 5 — the only adapter with a real bridge implementation
# (python-services/mt5-bridge). Unit-tested against an injected simulated
# transport; NOT verified against a real MetaTrader terminal.
# AEGIS_MT5_BRIDGE_URL=http://127.0.0.1:8790
# AEGIS_MT5_BRIDGE_TOKEN=replace-with-a-bridge-token
# AEGIS_MT5_BRIDGE_ENABLED=0
# Note the irregular spelling, preserved from legacy on purpose: the two trading
# flags drop `_BRIDGE`. `AEGIS_MT5_BRIDGE_TRADING_ENABLED` is NOT read.
# AEGIS_MT5_TRADING_ENABLED=0
# AEGIS_MT5_LIVE_ALLOWED=0
#
# The nine adapters below are PLANNED: the contract adapter is scaffolded and none
# has ever spoken to its provider. Each stays PLANNED until its own contract,
# sandbox/demo account and provider permissions are verified. Do not enable one
# because the variables exist.
# MetaTrader 4 (forex) — verify against a real MT4 bridge after MT5 verification.
# AEGIS_MT4_BRIDGE_URL=https://mt4-bridge.example.com
# AEGIS_MT4_BRIDGE_TOKEN=replace-with-a-bridge-token
# AEGIS_MT4_BRIDGE_ENABLED=0
# AEGIS_MT4_BRIDGE_TRADING_ENABLED=0
# AEGIS_MT4_BRIDGE_LIVE_ALLOWED=0
# Binance exchange (crypto) — exchange mapping and demo/sandbox verification required.
# AEGIS_BINANCE_CONNECTOR_URL=https://binance-bridge.example.com
# AEGIS_BINANCE_CONNECTOR_TOKEN=replace-with-a-bridge-token
# AEGIS_BINANCE_CONNECTOR_ENABLED=0
# AEGIS_BINANCE_CONNECTOR_TRADING_ENABLED=0
# AEGIS_BINANCE_CONNECTOR_LIVE_ALLOWED=0
# Bybit exchange (crypto) — exchange mapping and sandbox verification required.
# AEGIS_BYBIT_CONNECTOR_URL=https://bybit-bridge.example.com
# AEGIS_BYBIT_CONNECTOR_TOKEN=replace-with-a-bridge-token
# AEGIS_BYBIT_CONNECTOR_ENABLED=0
# AEGIS_BYBIT_CONNECTOR_TRADING_ENABLED=0
# AEGIS_BYBIT_CONNECTOR_LIVE_ALLOWED=0
# OKX exchange (crypto) — exchange mapping and sandbox verification required.
# AEGIS_OKX_CONNECTOR_URL=https://okx-bridge.example.com
# AEGIS_OKX_CONNECTOR_TOKEN=replace-with-a-bridge-token
# AEGIS_OKX_CONNECTOR_ENABLED=0
# AEGIS_OKX_CONNECTOR_TRADING_ENABLED=0
# AEGIS_OKX_CONNECTOR_LIVE_ALLOWED=0
# Coinbase exchange (crypto) — exchange mapping and sandbox verification required.
# AEGIS_COINBASE_CONNECTOR_URL=https://coinbase-bridge.example.com
# AEGIS_COINBASE_CONNECTOR_TOKEN=replace-with-a-bridge-token
# AEGIS_COINBASE_CONNECTOR_ENABLED=0
# AEGIS_COINBASE_CONNECTOR_TRADING_ENABLED=0
# AEGIS_COINBASE_CONNECTOR_LIVE_ALLOWED=0
# Kraken exchange (crypto) — exchange mapping and sandbox verification required.
# AEGIS_KRAKEN_CONNECTOR_URL=https://kraken-bridge.example.com
# AEGIS_KRAKEN_CONNECTOR_TOKEN=replace-with-a-bridge-token
# AEGIS_KRAKEN_CONNECTOR_ENABLED=0
# AEGIS_KRAKEN_CONNECTOR_TRADING_ENABLED=0
# AEGIS_KRAKEN_CONNECTOR_LIVE_ALLOWED=0
# Interactive Brokers (stock, etf, futures, options) — verify the gateway contract
# and a demo account first.
# AEGIS_IB_CONNECTOR_URL=https://ib-bridge.example.com
# AEGIS_IB_CONNECTOR_TOKEN=replace-with-a-bridge-token
# AEGIS_IB_CONNECTOR_ENABLED=0
# AEGIS_IB_CONNECTOR_TRADING_ENABLED=0
# AEGIS_IB_CONNECTOR_LIVE_ALLOWED=0
# Alpaca (stock, etf, crypto) — verify paper-account mapping and permissions first.
# AEGIS_ALPACA_CONNECTOR_URL=https://alpaca-bridge.example.com
# AEGIS_ALPACA_CONNECTOR_TOKEN=replace-with-a-bridge-token
# AEGIS_ALPACA_CONNECTOR_ENABLED=0
# AEGIS_ALPACA_CONNECTOR_TRADING_ENABLED=0
# AEGIS_ALPACA_CONNECTOR_LIVE_ALLOWED=0
# OANDA (forex) — verify the practice-account mapping first.
# AEGIS_OANDA_CONNECTOR_URL=https://oanda-bridge.example.com
# AEGIS_OANDA_CONNECTOR_TOKEN=replace-with-a-bridge-token
# AEGIS_OANDA_CONNECTOR_ENABLED=0
# AEGIS_OANDA_CONNECTOR_TRADING_ENABLED=0
# AEGIS_OANDA_CONNECTOR_LIVE_ALLOWED=0

# Bridge call budget, 1000..60000 ms. Legacy used 8 s in the generic connector and
# 5 s in the MT5 bridge; one budget applies to every connector here, deliberately
# shorter than MARKET_DATA_DEADLINE_MS because a bridge call sits on the order path,
# where waiting is worse than failing. A bridge call is never retried: retrying a
# POST /v1/orders that timed out is how an order gets placed twice.
BROKER_REQUEST_TIMEOUT_MS=8000
# How long a connector's health probe is cached, 1000..60000 ms. Order calls bypass
# this cache and always re-probe, so this bounds status reads, never a write.
BROKER_HEALTH_TTL_MS=5000

# ---------------------------------------------------------------------------
# Sports Intelligence (module: sports)
# ---------------------------------------------------------------------------
# Row 14 of docs/migration/UNFINISHED_MODULES.md, slice 1: the normalized data
# contracts, the data-quality and freshness gates, and the provider boundary.
# Nothing here is persisted yet — the seven tables ingestion writes are not
# created by any migration — so no sync, prediction, ticket, settlement,
# calibration or backtest can run. These variables configure what a *provider*
# is, not what may be done with its data.
#
# A default host configures NO provider at all, and that is the intended state for
# a platform with no verified sports data source.

# Module switch. Reported by the status surface; it does not register a provider.
WINDELS_SPORTS_ENABLED=0
# SANDBOX | PAPER | PRODUCTION. Anything else falls back to SANDBOX rather than
# silently selecting a mode that behaves differently from the one you set.
WINDELS_SPORTS_MODE=SANDBOX
# The labelled simulation provider needs BOTH this and WINDELS_SPORTS_MODE=SANDBOX.
# The second variable is not redundant: MODE defaults to SANDBOX, so mode alone
# would enable the simulation on a host that configured nothing at all. With both
# set, every record the provider emits carries `simulated: true` and its fixtures,
# odds and results are generated deterministically from a fixed seed — reproducible
# and never presented as real-world data. It performs no I/O.
WINDELS_SPORTS_SANDBOX=0
# Generic REST sports feed. Registered only when the base URL is present and valid,
# so leaving it unset means no real provider is consulted.
#
# Expected upstream contract (all responses JSON, UTC ISO-8601 timestamps):
#   GET {base}/fixtures?from=YYYY-MM-DD&to=YYYY-MM-DD
#   GET {base}/fixtures/{externalId}/odds
#   GET {base}/fixtures/{externalId}/results
#   GET {base}/health
#
# The base URL may include a path prefix (https://vendor.example.com/v1) — it is
# kept, unlike the broker bridge URLs which are reduced to their origin. Embedded
# credentials, a query string and a fragment are all refused, and plain http:// is
# refused in production except for a loopback host.
# WINDELS_SPORTS_HTTP_ID=http-provider
# WINDELS_SPORTS_HTTP_BASE_URL=
# WINDELS_SPORTS_HTTP_TOKEN=
# Upstream timeout in SECONDS, 1..120. Out of range is a boot failure, not a
# silent clamp: a timeout nobody noticed is a timeout nobody can reason about.
WINDELS_SPORTS_HTTP_TIMEOUT=10

# ---------------------------------------------------------------------------
# Lottery Intelligence (module: lottery, row 15 slice 1)
# ---------------------------------------------------------------------------
# The provider boundary for the lottery module. A default host configures NO
# provider: the official feed is disabled and the sandbox is off, and
# /api/v1/lottery/status reports DISABLED_NO_PROVIDER — nothing fabricated.

# The labelled simulation provider (pipeline testing only). Deterministic draws
# walked backwards over the real EuroMillions schedule from today, generated from
# a fixed seed, always sourced "sandbox-simulation", never presented as official
# results. Performs no I/O.
WINDELS_LOTTERY_SANDBOX=0
# An authorized official EuroMillions feed. Registered ONLY when enabled=1 AND the
# URL is a clean https:// URL with no embedded credentials AND license and source
# metadata are present — legacy's own safety defaults, kept exactly. The upstream
# contract:
#   GET {url}/draws?from=YYYY-MM-DD&to=YYYY-MM-DD&limit=N
#     -> {"data":{"draws":[{"externalId":"...","drawDate":"YYYY-MM-DD","main":[...],"stars":[...],"sourceTimestamp":"..."}]}}
#   GET {healthUrl} -> {"ok":true,"version":"..."}
# No adapter is verified against any real vendor; enabling this does not mark a
# draw VERIFIED on its own — every draw still passes full validation.
WINDELS_LOTTERY_OFFICIAL_ENABLED=0
# WINDELS_LOTTERY_OFFICIAL_URL=
# WINDELS_LOTTERY_OFFICIAL_HEALTH_URL=
# WINDELS_LOTTERY_OFFICIAL_TOKEN=
# WINDELS_LOTTERY_OFFICIAL_LICENSE=
# WINDELS_LOTTERY_OFFICIAL_SOURCE=authorized-official-feed
# WINDELS_LOTTERY_OFFICIAL_JACKPOT_URL=
