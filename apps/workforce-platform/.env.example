# WINDELS AI WORKFORCE — Node platform configuration.
#
# Every variable the platform reads is listed here with its default. Values shown
# are safe for a local machine, NOT for a deployment: secrets belong in cPanel's
# environment UI (or a private shell file you source), never in this file.
# The server does not auto-load .env — export them, or `set -a; . ./.env; set +a`.
#
# `npm run verify:install` fails if a variable the config reads is missing here.

# ---- runtime --------------------------------------------------------------
# development | test | production. Anything else is refused at boot.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# Required in production and must be an HTTPS origin: it is the same-origin
# reference for CSRF/origin checks, the cookie scope, and CORS comparisons.
# PUBLIC_BASE_URL=https://workforce.example.com
# Set true only after confirming the cPanel/Passenger proxy hop, otherwise
# X-Forwarded-For is attacker-controlled and per-client limits key on the proxy.
TRUST_PROXY=false
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Stamp the build so /api/v1/system/status reports what is actually deployed.
# WF_BUILD_VERSION=0.3.0+2026-10-09
# Override the application root (data/ uploads resolve against it) and the static
# document root. Only ever point these at public assets.
# WF_APP_ROOT=/home/account/apps/workforce-platform
# WF_PUBLIC_DIR=/home/account/apps/workforce-platform/public
# Public landing-site copy and install metadata (site name, manifest, SEO).
# These drive the rendered public pages, /robots.txt, /sitemap.xml and
# /manifest.webmanifest; legacy parity: application/config/seo.php (VP_*).
# SITE_NAME=WINDELS AI WORKFORCE
# SITE_DESCRIPTION=WINDELS AI WORKFORCE — research, learning and operational tools in one governed workspace. Evidence-first, audited and fail-closed.
# Defaults to " · <SITE_NAME>"; set empty to drop the suffix.
# SITE_TITLE_SUFFIX=
# THEME_COLOR=#071511
# SITE_BACKGROUND_COLOR=#071511
# One of: "index, follow" | "noindex, follow" | "index, nofollow" | "noindex, nofollow".
# ROBOTS=index, follow
# SITE_KEYWORDS=WINDELS AI Workforce, AI workforce, language learning, market intelligence, sports research, lottery analysis, lead discovery
# Absolute https:// URL of the shared social image. Without it the canonical
# origin's /icons/icon-512.png is used, and with no PUBLIC_BASE_URL the Open
# Graph image tag is omitted rather than publishing a relative URL.
# SITE_OG_IMAGE=https://workforce.example.com/icons/icon-512.png
# Operator announcements, "|" separated, max three, shown as the site banner.
# Empty by default: a banner that claims an unported module would be a lie.
# SITE_ANNOUNCEMENT=Welcome to WINDELS AI WORKFORCE.
# Size of the legacy authored language-teacher registry quoted by the public
# pages. Language learning is not ported to Node yet, so this is a stated
# constant describing the product, not a live count. 0 drops the claim.
# SITE_LANGUAGE_COUNT=20
# Public contact intake throttle (per client address) and accepted message
# length; mirrors the legacy form rules (10..2000 characters).
# CONTACT_MAX_PER_HOUR=3
# CONTACT_WINDOW_MS=3600000

# ---- storage adapter ------------------------------------------------------
# auto | mysql | file. `auto` picks mysql when DB_* are present, else file.
# `file` is refused in production unless ALLOW_FILE_STORE_IN_PRODUCTION=1
# acknowledges: single process, no transactions, no cross-process locking.
STORAGE_ADAPTER=auto
# Where the file adapter keeps its write-ahead log, and where avatars go.
# Defaults: .data/store (development) / data/store (production), data/uploads.
# STORAGE_DIR=/home/account/apps/workforce-platform/.data/store
# UPLOAD_DIR=/home/account/apps/workforce-platform/data/uploads
ALLOW_FILE_STORE_IN_PRODUCTION=0
# Connection pool for the MySQL adapter.
DB_CONNECTION_LIMIT=5

# ---- database (MySQL/MariaDB through cPanel) ------------------------------
# Required when STORAGE_ADAPTER=mysql.
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=cpanel_database_name
# DB_USER=cpanel_database_user
# DB_PASSWORD=replace-with-a-secret
# CLI-only, separate credentials for the one-time legacy identity import. These
# are deliberately NOT read by the server, so a web process can never touch the
# legacy database. Used by `npm run import:identity`.
# LEGACY_DB_HOST=localhost
# LEGACY_DB_PORT=3306
# LEGACY_DB_NAME=legacy_database_name
# LEGACY_DB_USER=legacy_readonly_user
# LEGACY_DB_PASSWORD=replace-with-a-secret
# LEGACY_DB_CONNECTION_LIMIT=2

# ---- sessions and cookies --------------------------------------------------
# Generate a fresh value of at least 32 bytes per environment. It also keys the
# CSRF token derivation and the login-attempt hashing, so rotating it invalidates
# every session — which is exactly what you want after an incident.
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
# Web session lifetime, 300s..7d. A remembered sign-in extends the same session
# up to 30 days; a password change returns it to this TTL.
SESSION_TTL_SECONDS=28800
# Force Secure (and therefore the __Host- name) outside production for tests.
# COOKIE_SECURE=0

# ---- request handling ------------------------------------------------------
# JSON/form body cap, 1 KiB..1 MiB. Bodies are buffered, never streamed to disk.
BODY_LIMIT_BYTES=16384
# Socket inactivity cap for the whole request/response cycle.
REQUEST_TIMEOUT_MS=15000
# multipart cap for avatar uploads, 32 KiB..16 MiB (defaults to UPLOAD_MAX_BYTES + 64 KiB).
UPLOAD_BODY_LIMIT_BYTES=2113536
# Concurrent in-flight requests allowed per client address (0 disables). A
# windowed counter limits rate; this stops one address holding hundreds of slow
# connections open. Set it deliberately on shared-host deployments, not by guess.
# MAX_REQUESTS_PER_CLIENT=0

# ---- uploads ---------------------------------------------------------------
UPLOADS_ENABLED=1
# Per-file cap, 1 KiB..10 MiB. Content is sniffed; the declared MIME is ignored.
UPLOAD_MAX_BYTES=2097152
# Private cache lifetime for authorized avatar reads.
UPLOAD_CACHE_SECONDS=300

# ---- rate limiting and lockout (per process; a floor, not a global ceiling) --
RATE_LIMIT_ENABLED=1
RATE_LIMIT_API_MAX=120
RATE_LIMIT_API_WINDOW_MS=60000
# Failed sign-ins per client per route window; also the credential-spray throttle.
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MS=60000
# Cap on tracked buckets so a spread of random keys cannot grow memory.
RATE_LIMIT_MAX_ENTRIES=20000
# Analysis is the most expensive authenticated surface here: one run fetches up to
# 8 upstream series (a forex/commodity run also pulls seven reference legs) and one
# consensus scan is up to 10 runs, so a 10-symbol scan can fan out into ~80
# provider calls. The API limiter above bounds requests; these bound work.
# Window limits are per client address and are charged before validation, so a
# refused request still counts.
RATE_LIMIT_ANALYSIS_RUN_MAX=12
RATE_LIMIT_ANALYSIS_RUN_WINDOW_MS=600000
RATE_LIMIT_ANALYSIS_CONSENSUS_MAX=4
RATE_LIMIT_ANALYSIS_CONSENSUS_WINDOW_MS=600000
# In-flight analysis runs per signed-in session (a scan holds one slot). 0
# disables the cap, matching MAX_REQUESTS_PER_CLIENT semantics.
ANALYSIS_MAX_CONCURRENT_RUNS=2
# Strategy Lab cost control. A backtest fetches up to 5000 candles and simulates
# every bar; an optimization re-runs the backtester once per grid combination and
# once per walk-forward segment (~50 simulations for trend-following), so its
# window is much tighter. Window limits are per client address and are charged
# before validation, so a refused request still counts.
RATE_LIMIT_STRATEGY_BACKTEST_MAX=12
RATE_LIMIT_STRATEGY_BACKTEST_WINDOW_MS=600000
RATE_LIMIT_STRATEGY_OPTIMIZE_MAX=2
RATE_LIMIT_STRATEGY_OPTIMIZE_WINDOW_MS=600000
# In-flight backtests + optimizations per signed-in session. Lower than the
# analysis cap of 2 on purpose: one optimize slot can hold ~50 simulations, so two
# slots would put ~100 on a host that may have two cores. 0 disables the cap.
STRATEGY_MAX_CONCURRENT_RUNS=1
# Days of analysis runs to keep. Each run stores a full LONGTEXT payload (agents,
# debate transcript, scenarios, setup, risk decision, provenance) and nothing else
# ever deletes a row. Applied by an operator, never by a request:
#   node tools/prune-analysis-runs.mjs            # dry run, deletes nothing
#   node tools/prune-analysis-runs.mjs --apply    # actually delete
# 0 keeps runs forever.
ANALYSIS_RETENTION_DAYS=90
# Account lockout: N failures lock that account for the window. Keyed per account,
# never per address, so a shared office IP cannot be used to deny service.
LOGIN_LOCKOUT_FAILURES=5
LOGIN_LOCKOUT_MS=900000

# ---- CORS and Content Security Policy --------------------------------------
# Comma-separated exact origins for browser clients served from another origin.
# Wildcards and plain http (in production) are refused at boot. Same-origin
# deployments need nothing here.
# CORS_ALLOWED_ORIGINS=https://admin.example.com
# Development-only convenience for an inline <script> in a hand-written page.
# Ignored — not honoured — in production.
# CSP_UNSAFE_INLINE=0

# ---- password policy (mirrors the legacy PHP application) -------------------
PASSWORD_MIN_LENGTH=12
ADMIN_PASSWORD_MIN_LENGTH=14

# ---- market data providers (Phase 4) --------------------------------------
# The provider chain is Binance (crypto, priority 10) → Frankfurter/ECB (daily
# forex, 20) → licensed stock/ETF/futures/options adapters (30–33, inert until
# configured) → synthetic demo generator (999, always last).
# Set 0 on a host with no outbound access: the real providers are then not
# registered at all, and every response says it came from the synthetic provider.
MARKET_DATA_REAL_PROVIDERS=1
# Set 0 to refuse synthetic data outright. Requests then fail with 503
# SYNTHETIC_DATA_DISABLED instead of being served simulated candles — the setting
# to use on any host whose output must never be mistaken for market data.
MARKET_DATA_ALLOW_SYNTHETIC=1
# Per-request timeout for one provider call, 500..30000 ms.
MARKET_DATA_TIMEOUT_MS=6000
# Retries per provider call, 0..5 (backoff 300 ms × 2^attempt, capped at 1 s).
MARKET_DATA_RETRIES=2
# Hard budget for a whole market-data request across every provider in the chain,
# 1000..120000 ms. Added by this port: the legacy manager had no overall deadline.
MARKET_DATA_DEADLINE_MS=15000
# Shorter budget for provider health probes, 500..60000 ms.
MARKET_DATA_HEALTH_TIMEOUT_MS=5000
# Public market-data hosts. Override only for a mirror or a corporate proxy;
# production refuses a non-HTTPS value.
# BINANCE_API_BASE=https://api.binance.com
# FRANKFURTER_API_BASE=https://api.frankfurter.dev
# Licensed feeds (stock, ETF, futures, options). Each adapter stays DISABLED until
# _ENABLED=1, and NOT_CONFIGURED until a safe URL, license metadata and an
# explicit symbol allow-list are supplied. No symbol discovery, no invented data.
# Variable names keep the legacy AEGIS_* spelling so a cPanel environment carries
# over unchanged; the same seven variables exist for AEGIS_ETF_DATA_,
# AEGIS_FUTURES_DATA_ and AEGIS_OPTIONS_DATA_ (priorities 31, 32 and 33).
# AEGIS_STOCK_DATA_URL=https://licensed-feed.example.com/stocks
# AEGIS_STOCK_DATA_HEALTH_URL=https://licensed-feed.example.com/health
# AEGIS_STOCK_DATA_TOKEN=replace-with-a-bearer-token
# AEGIS_STOCK_DATA_LICENSE=vendor-license-reference
# AEGIS_STOCK_DATA_ENABLED=0
# Delayed unless set to exactly 0; reported in the response provenance.
# AEGIS_STOCK_DATA_DELAYED=1
# Comma or space separated allow-list, upper-cased, 1..64 chars of [A-Z0-9._:-].
# AEGIS_STOCK_DATA_SYMBOLS=AAPL,MSFT
