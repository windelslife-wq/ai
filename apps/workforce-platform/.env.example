# Development example only. Production values belong in cPanel's environment UI.
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
PUBLIC_BASE_URL=https://node.example.com
# Set true only after confirming the cPanel/Passenger proxy hop.
TRUST_PROXY=false
LOG_LEVEL=info

DB_HOST=localhost
DB_PORT=3306
DB_NAME=cpanel_database_name
DB_USER=cpanel_database_user
DB_PASSWORD=replace-with-a-secret
DB_CONNECTION_LIMIT=5

# Generate a fresh random value with at least 32 bytes for each environment.
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
SESSION_TTL_SECONDS=28800
