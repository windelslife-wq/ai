# WINDELS AI WORKFORCE — Node platform configuration.
#
# Every variable the platform reads is listed here with its default. Values shown
# are safe for a local machine, NOT for a deployment: secrets belong in cPanel's
# environment UI (or a private shell file you source), never in this file.
# The server does not auto-load .env — export them, or `set -a; . ./.env; set +a`.
#
# `npm run verify:install` fails if a variable the config reads is missing here.

# ---- runtime --------------------------------------------------------------
# development | test | production. Anything else is refused at boot.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# Required in production and must be an HTTPS origin: it is the same-origin
# reference for CSRF/origin checks, the cookie scope, and CORS comparisons.
# PUBLIC_BASE_URL=https://workforce.example.com
# Set true only after confirming the cPanel/Passenger proxy hop, otherwise
# X-Forwarded-For is attacker-controlled and per-client limits key on the proxy.
TRUST_PROXY=false
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Stamp the build so /api/v1/system/status reports what is actually deployed.
# WF_BUILD_VERSION=0.3.0+2026-10-09
# Override the application root (data/ uploads resolve against it) and the static
# document root. Only ever point these at public assets.
# WF_APP_ROOT=/home/account/apps/workforce-platform
# WF_PUBLIC_DIR=/home/account/apps/workforce-platform/public
# Public landing-site copy and install metadata (site name, manifest, SEO).
# SITE_NAME=WINDELS AI WORKFORCE
# SITE_DESCRIPTION=Research, learning and operational tools with clear guardrails.
# SITE_TITLE_SUFFIX=
# THEME_COLOR=#071511
# ROBOTS=index, follow
# SITE_KEYWORDS=

# ---- storage adapter ------------------------------------------------------
# auto | mysql | file. `auto` picks mysql when DB_* are present, else file.
# `file` is refused in production unless ALLOW_FILE_STORE_IN_PRODUCTION=1
# acknowledges: single process, no transactions, no cross-process locking.
STORAGE_ADAPTER=auto
# Where the file adapter keeps its write-ahead log, and where avatars go.
# Defaults: .data/store (development) / data/store (production), data/uploads.
# STORAGE_DIR=/home/account/apps/workforce-platform/.data/store
# UPLOAD_DIR=/home/account/apps/workforce-platform/data/uploads
ALLOW_FILE_STORE_IN_PRODUCTION=0
# Connection pool for the MySQL adapter.
DB_CONNECTION_LIMIT=5

# ---- database (MySQL/MariaDB through cPanel) ------------------------------
# Required when STORAGE_ADAPTER=mysql.
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=cpanel_database_name
# DB_USER=cpanel_database_user
# DB_PASSWORD=replace-with-a-secret
# CLI-only, separate credentials for the one-time legacy identity import. These
# are deliberately NOT read by the server, so a web process can never touch the
# legacy database. Used by `npm run import:identity`.
# LEGACY_DB_HOST=localhost
# LEGACY_DB_PORT=3306
# LEGACY_DB_NAME=legacy_database_name
# LEGACY_DB_USER=legacy_readonly_user
# LEGACY_DB_PASSWORD=replace-with-a-secret
# LEGACY_DB_CONNECTION_LIMIT=2

# ---- sessions and cookies --------------------------------------------------
# Generate a fresh value of at least 32 bytes per environment. It also keys the
# CSRF token derivation and the login-attempt hashing, so rotating it invalidates
# every session — which is exactly what you want after an incident.
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
# Web session lifetime, 300s..7d. A remembered sign-in extends the same session
# up to 30 days; a password change returns it to this TTL.
SESSION_TTL_SECONDS=28800
# Force Secure (and therefore the __Host- name) outside production for tests.
# COOKIE_SECURE=0

# ---- request handling ------------------------------------------------------
# JSON/form body cap, 1 KiB..1 MiB. Bodies are buffered, never streamed to disk.
BODY_LIMIT_BYTES=16384
# Socket inactivity cap for the whole request/response cycle.
REQUEST_TIMEOUT_MS=15000
# multipart cap for avatar uploads, 32 KiB..16 MiB (defaults to UPLOAD_MAX_BYTES + 64 KiB).
UPLOAD_BODY_LIMIT_BYTES=2113536

# ---- uploads ---------------------------------------------------------------
UPLOADS_ENABLED=1
# Per-file cap, 1 KiB..10 MiB. Content is sniffed; the declared MIME is ignored.
UPLOAD_MAX_BYTES=2097152
# Private cache lifetime for authorized avatar reads.
UPLOAD_CACHE_SECONDS=300

# ---- rate limiting and lockout (per process; a floor, not a global ceiling) --
RATE_LIMIT_ENABLED=1
RATE_LIMIT_API_MAX=120
RATE_LIMIT_API_WINDOW_MS=60000
# Failed sign-ins per client per route window; also the credential-spray throttle.
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MS=60000
# Cap on tracked buckets so a spread of random keys cannot grow memory.
RATE_LIMIT_MAX_ENTRIES=20000
# Account lockout: N failures lock that account for the window. Keyed per account,
# never per address, so a shared office IP cannot be used to deny service.
LOGIN_LOCKOUT_FAILURES=5
LOGIN_LOCKOUT_MS=900000

# ---- CORS and Content Security Policy --------------------------------------
# Comma-separated exact origins for browser clients served from another origin.
# Wildcards and plain http (in production) are refused at boot. Same-origin
# deployments need nothing here.
# CORS_ALLOWED_ORIGINS=https://admin.example.com
# Development-only convenience for an inline <script> in a hand-written page.
# Ignored — not honoured — in production.
# CSP_UNSAFE_INLINE=0

# ---- password policy (mirrors the legacy PHP application) -------------------
PASSWORD_MIN_LENGTH=12
ADMIN_PASSWORD_MIN_LENGTH=14
