Options -Indexes
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(?:database|tools|tests|runtime)/ - [F,L,NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ index.php/$1 [L]
</IfModule>

# Never serve deployment configuration or database exports over HTTP.
<FilesMatch "^(\.env|\.env\.example)$">
  Require all denied
</FilesMatch>
