{
  "name": "africa-mobility-platforms",
  "private": true,
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:contracts": "node --import tsx --test packages/shared/test/*.test.ts apps/api/test/*.test.ts",
    "check:workforce": "npm run check --workspace=@windels/workforce-platform",
    "build:workforce-client": "npm --prefix apps/workforce-platform/client run build",
    "dev:workforce-client": "npm --prefix apps/workforce-platform/client run dev",
    "start:workforce-platform": "npm run start --workspace=@windels/workforce-platform"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "tsx": "4.19.3",
    "typescript": "5.8.3"
  }
}
